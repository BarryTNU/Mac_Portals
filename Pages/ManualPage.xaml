<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Portals.Pages.ManualPage"
    Title="Portals - User Manual"
    BackgroundColor="#252525">

    <Grid RowDefinitions="Auto,*"
          Padding="15"
          RowSpacing="10">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="5">

            <Label Text="PORTALS - USER MANUAL"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>

            <Button Grid.Column="1"
                    Text="Close"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#444444"
                    TextColor="White"
                    CornerRadius="5"
                    Padding="15,5"/>
        </Grid>

        <!-- Manual content -->
        <Border Grid.Row="1"
                BackgroundColor="#303030"
                Stroke="#505050"
                StrokeThickness="1"
                Padding="20">

            <ScrollView>
                <Label x:Name="ManualContent"
                       TextColor="White"
                       FontSize="14"
                       LineHeight="1.4"
                       HorizontalOptions="Fill"
                       VerticalOptions="Start"/>
            </ScrollView>

        </Border>

    </Grid>
</ContentPage>

