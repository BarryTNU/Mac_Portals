<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Portals.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Portals">

    <Grid Padding="20"
          BackgroundColor="#202020"
          RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
      ColumnDefinitions="*,Auto"
      ColumnSpacing="10"
      Margin="0,0,0,20">

            <Label
                Text="My Portals"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

     

        </Grid>

        <!-- Portal collection -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Portals}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="15"
                    VerticalItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        BackgroundColor="#404B5A"
                        Stroke="#607080"
                        StrokeThickness="1"
                        Padding="15"
                        HeightRequest="250">

                        <VerticalStackLayout Spacing="10">

                               <Label
                                Text="{Binding Name}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="White" />


                            <VerticalStackLayout
                                BindableLayout.ItemsSource="{Binding Shortcuts}"
                                Spacing="4">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>


                                        <HorizontalStackLayout Spacing="5">

                                                                                <Button
                                            Text="{Binding Name}"
                                            FontSize="13"
                                            TextColor="White"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Start"
                                            Padding="8,2"
                                            Clicked="OpenShortcut_Clicked"
                                            CommandParameter="{Binding .}" />

                                            <Button
                                            Text="✎"
                                            FontSize="13"
                                            TextColor="#CCCCCC"
                                            BackgroundColor="Transparent"
                                            Padding="4,2"
                                            WidthRequest="30"
                                            Clicked="RenameShortcut_Clicked"
                                            CommandParameter="{Binding .}" />


                                             <Button
                                            Text="⚙"
                                            FontSize="13"
                                            TextColor="#CCCCCC"
                                            BackgroundColor="Transparent"
                                            Padding="4,2"
                                            WidthRequest="30"
                                            Clicked="EditShortcutTarget_Clicked"
                                            CommandParameter="{Binding .}" />


                                            <Button
                                            Text="×"
                                            FontSize="14"
                                            TextColor="#FF9999"
                                            BackgroundColor="Transparent"
                                            Padding="4,2"
                                            WidthRequest="30"
                                            Clicked="DeleteShortcut_Clicked"
                                            CommandParameter="{Binding .}" />


                                        </HorizontalStackLayout>


                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>

                            </VerticalStackLayout>


                            <Label
                                Text="No shortcuts yet"
                                FontSize="13"
                                TextColor="#CCCCCC" />

                                                    <Button
                                Text="Rename"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,2"
                                HorizontalOptions="Start"
                                Clicked="RenamePortal_Clicked"
                                CommandParameter="{Binding .}" />

                                <Button
                                Text="Delete"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,2"
                                HorizontalOptions="Start"
                                BackgroundColor="#8B3333"
                                TextColor="White"
                                Clicked="DeletePortal_Clicked"
                                CommandParameter="{Binding .}" />

                            <Button
                                Text="+ Add Shortcut"
                                FontSize="12"
                                HeightRequest="32"
                                Padding="10,2"
                                HorizontalOptions="Start"
                                BackgroundColor="#356A91"
                                TextColor="White"
                                Clicked="AddShortcut_Clicked"
                                CommandParameter="{Binding .}" />


                        </VerticalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
